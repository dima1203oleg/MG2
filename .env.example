# ============================================================================
# MARSHGO PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# No real secrets or private keys are stored in this file.
# ============================================================================

# --- Core Runtime ---
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# --- Security & Cryptography ---
# HMAC-SHA256 secret used to sign and verify MarshPass boarding QR tokens (minimum 32 chars in production)
TICKET_HMAC_SECRET="replace-with-32-byte-production-hmac-secret"
# Persistent state file path for durable local/container state across restarts
MARSHGO_DATA_FILE="./data/marshgo-state.json"

# --- Optional Database & Cache Upstreams (Canonical MarshGO-Server compatibility) ---
DATABASE_URL="postgresql://marshgo:password@localhost:5432/marshgo"
REDIS_URL="redis://localhost:6379"

# --- Geospatial, Maps & Routing ---
VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
OSRM_BASE_URL="https://router.project-osrm.org"

# --- External Commercial Partner Credentials (BLOCKED_EXTERNAL until provided) ---
INFOBUS_API_KEY=""
KIWITAXI_SECURITY_TOKEN=""
ODESA_X24_API_TOKEN=""

# --- AI Studio Platform Runtime ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

